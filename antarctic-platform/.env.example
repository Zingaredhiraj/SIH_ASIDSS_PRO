# ===================================================================
# Antarctic Station Digital Platform — Environment Variables Template
# PS 26060 — MoES · NCPOR · Disaster Management
# ===================================================================
# Copy this file:
#   Backend: cp .env.example backend/.env
#   Frontend: cp .env.example frontend/.env.local
# NEVER commit the real .env/.env.local files.

# =========================
# BACKEND ENVIRONMENT VARS
# =========================

# MongoDB connection string
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
MONGO_DB=antarctic_platform

# JWT (generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq API Key — free at https://console.groq.com
# If empty, the AI assistant uses the deterministic offline fallback (no Groq needed)
GROQ_API_KEY=

# CORS allowed origins — comma-separated JSON array
# Local dev:   ["http://localhost:3000","http://localhost:3001"]
# Production:  ["https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Telemetry simulator update interval (seconds)
TELEMETRY_INTERVAL_SECONDS=5

# Server port — Render injects PORT automatically; 8000 is used for local dev
PORT=8000

# ==========================
# FRONTEND ENVIRONMENT VARS
# (file: frontend/.env.local)
# ==========================

# Backend API base URL
# Local dev:   http://localhost:8000
# Production:  https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base URL
# Local dev:   ws://localhost:8000
# Production:  wss://your-backend.onrender.com  (note: wss:// not ws:// for HTTPS backends)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ===================================================================
# DEMO CREDENTIALS (pre-seeded by backend/db/seed.py)
# ===================================================================
# Role          | Email                     | Password
# --------------|---------------------------|------------------
# Admin         | admin@antarctic.in        | Admin@1234
# Operator      | operator@antarctic.in     | Operator@1234
# Scientist     | scientist@antarctic.in    | Scientist@1234
# Security Ofcr | security@antarctic.in     | Security@1234
# NCPOR HQ      | hq@ncpor.gov.in           | NCPOR@1234
# ===================================================================
