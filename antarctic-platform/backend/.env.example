# Backend Environment Variables
# Copy this file to .env and fill in the values

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=antarctic_platform

# JWT Configuration
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI - Groq API (optional - leave blank for offline fallback)
GROQ_API_KEY=

# CORS - comma-separated list of allowed origins
# Local dev:
CORS_ORIGINS=["http://localhost:3000"]
# Production (set after Vercel deploy):
# CORS_ORIGINS=["https://your-app.vercel.app"]

# Telemetry simulation interval (seconds)
TELEMETRY_INTERVAL_SECONDS=5
